# Zoom API Credentials (Server-to-Server OAuth)
ZOOM_ACCOUNT_ID=your_account_id
ZOOM_CLIENT_ID=your_client_id
ZOOM_CLIENT_SECRET=your_client_secret

# Google Sheets API (use env vars OR credentials.json file)
# Option 1: Environment variables (recommended for production)
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option 2: Credentials file (for local development)
# GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# Google Drive - ID of shared drive or folder to store sheets
GOOGLE_SHARED_DRIVE_ID=your_shared_drive_id

# App Settings
FRONTEND_URL=http://localhost:3000
