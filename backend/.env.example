# Zoom API Credentials (Server-to-Server OAuth)
ZOOM_ACCOUNT_ID=your_account_id
ZOOM_CLIENT_ID=your_client_id
ZOOM_CLIENT_SECRET=your_client_secret

# Google Sheets API (use env vars OR credentials.json file)
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# The single spreadsheet that contains all session tabs
# Get this from your spreadsheet URL: https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id

# App Settings
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Live Tutor (in-meeting assistant)
# ---------------------------------------------------------------------------
# Opus 4.8 API key used to DRAFT policy-compliant answers. Without it, the AI
# drafting features are disabled but the rest of the tutor (reminders, manual
# messages, approval queue, logging) still works.
ANTHROPIC_API_KEY=

# Base URL of your self-hosted Meeting SDK bot's control API (see TUTOR_BOT.md).
# If unset, the backend runs in "null bot" mode: it records what it WOULD send
# in the message log but sends nothing to a meeting. Great for testing the UI.
TUTOR_BOT_BASE_URL=

# Shared secret. Sent to your bot as the X-Tutor-Bot-Secret header on outbound
# calls, and required on inbound POSTs to /api/tutor/bot/events when set.
TUTOR_BOT_SHARED_SECRET=

# Where the tutor's SQLite DB lives (defaults to data/tutor.db, which is on the
# Render disk so it survives deploys).
TUTOR_DB=data/tutor.db
