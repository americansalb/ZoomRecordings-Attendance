# Zoom API Credentials (Server-to-Server OAuth)
ZOOM_ACCOUNT_ID=your_account_id
ZOOM_CLIENT_ID=your_client_id
ZOOM_CLIENT_SECRET=your_client_secret

# Google Sheets API (use env vars OR credentials.json file)
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# The single spreadsheet that contains all session tabs
# Get this from your spreadsheet URL: https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id

# App Settings
FRONTEND_URL=http://localhost:3000
