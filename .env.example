# =============================================================================
# ZOOM MULTI-ACCOUNT CONFIGURATION
# =============================================================================
# You can configure multiple Zoom accounts using numbered environment variables
# Each account needs: ZOOM_ACCOUNT_N_ID, ZOOM_ACCOUNT_N_CLIENT_ID,
#                     ZOOM_ACCOUNT_N_CLIENT_SECRET, and ZOOM_ACCOUNT_N_NAME

# Account 1 (Primary)
ZOOM_ACCOUNT_1_ID=your_zoom_account_id_1
ZOOM_ACCOUNT_1_CLIENT_ID=your_client_id_1
ZOOM_ACCOUNT_1_CLIENT_SECRET=your_client_secret_1
ZOOM_ACCOUNT_1_NAME=Main Account

# Account 2 (Secondary) - Optional
ZOOM_ACCOUNT_2_ID=your_zoom_account_id_2
ZOOM_ACCOUNT_2_CLIENT_ID=your_client_id_2
ZOOM_ACCOUNT_2_CLIENT_SECRET=your_client_secret_2
ZOOM_ACCOUNT_2_NAME=Secondary Account

# Account 3 - Add more as needed
# ZOOM_ACCOUNT_3_ID=your_zoom_account_id_3
# ZOOM_ACCOUNT_3_CLIENT_ID=your_client_id_3
# ZOOM_ACCOUNT_3_CLIENT_SECRET=your_client_secret_3
# ZOOM_ACCOUNT_3_NAME=Third Account

# =============================================================================
# LEGACY SINGLE ACCOUNT (Backwards Compatible)
# =============================================================================
# If you only have one account, you can still use the old format:
# ZOOM_ACCOUNT_ID=your_zoom_account_id
# ZOOM_CLIENT_ID=your_client_id
# ZOOM_CLIENT_SECRET=your_client_secret

# =============================================================================
# GOOGLE CREDENTIALS
# =============================================================================
GOOGLE_CLIENT_EMAIL=your_service_account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=your_main_spreadsheet_id
ROSTER_SPREADSHEET_ID=your_roster_spreadsheet_id
